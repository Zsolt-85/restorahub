rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getCurrentUserRole() {
      return userDocExists() ? getCurrentUser().data.role : '';
    }

    function getCurrentUserBusinessId() {
      return userDocExists() ? getCurrentUser().data.businessId : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && getCurrentUserRole() == 'super_admin';
    }

    function isBusinessAdmin() {
      return isSignedIn() && getCurrentUserRole() == 'business_admin';
    }

    function isProfessional() {
      return isSignedIn() && getCurrentUserRole() in ['professional', 'staff'];
    }

    function isStaff() {
      return isProfessional();
    }

    function isCustomer() {
      return isSignedIn() && getCurrentUserRole() == 'customer';
    }

    function isBusinessMatch(bizId) {
      return isSignedIn() &&
        bizId != null &&
        bizId != '' &&
        bizId == getCurrentUserBusinessId();
    }

    function isSameBusiness(userId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.businessId == getCurrentUserBusinessId();
    }

    function isBusinessMember(userId) {
      return isOwner(userId) || isSameBusiness(userId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSameBusiness(userId) || isSuperAdmin();
      // Staff/admin/super-admin can LIST users (team management, manual
      // booking customer lookup). Evaluated on the requester's own role, so
      // it provably holds for whole queries — unlike per-doc conditions.
      // Residual risk (cross-tenant reads by staff) is tracked for Phase 5
      // claims-gated reads. Customers cannot list; they use staff_directory.
      allow list: if isProfessional() || isBusinessAdmin() || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'businessId'])) || isSuperAdmin() || (isBusinessAdmin() && isSameBusiness(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'businessId']));
      allow delete: if isSuperAdmin();
    }

    // Public bookable-staff directory (PII-free). Customer booking discovery
    // depends on listing this collection, which users-list rules forbid.
    match /staff_directory/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      // Solo staff (no business) own their services: businessId is null/empty
      // and they must be assigned to create, or already assigned to update.
      allow create: if isSuperAdmin() || isBusinessMatch(request.resource.data.businessId) || (isProfessional() && (request.resource.data.businessId == null || request.resource.data.businessId == ''));
      allow update, delete: if isSuperAdmin() || isBusinessMatch(resource.data.businessId) || (isProfessional() && (resource.data.businessId == null || resource.data.businessId == '') && request.auth.uid in resource.data.get('assignedProfessionalIds', []));
    }

    match /appointments/{appointmentId} {
      allow get: if isOwner(resource.data.customerId) ||
                    isOwner(resource.data.professionalId) ||
                    isBusinessMatch(resource.data.businessId) ||
                    isSuperAdmin();
      // NOTE: list stays authenticated-only for pilot (customer/professional
      // queries filter by customerId/professionalId+businessId client-side).
      // Tighten with request.query constraints once all queries send businessId.
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['customerId', 'professionalId', 'dateTime', 'service']);
      allow update: if isOwner(resource.data.customerId) ||
                    isOwner(resource.data.professionalId) ||
                    isBusinessMatch(resource.data.businessId) ||
                    isSuperAdmin();
      allow delete: if isBusinessMatch(resource.data.businessId) || isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.customerId) ||
                    isOwner(resource.data.professionalId) ||
                    isBusinessMatch(resource.data.businessId) ||
                    isSuperAdmin();
      allow create, update: if isSignedIn() && (request.resource.data.professionalId == request.auth.uid || isSuperAdmin() || (isBusinessAdmin() && isBusinessMatch(request.resource.data.businessId)));
      allow delete: if isSuperAdmin() || (isBusinessAdmin() && isBusinessMatch(resource.data.businessId));
    }

    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.receiverId) || isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    match /businesses/{businessId} {
      // Intentional public read: customers discover businesses/services without login.
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isSignedIn() && isBusinessMatch(businessId));
      allow delete: if isSuperAdmin();
    }
  }
}
